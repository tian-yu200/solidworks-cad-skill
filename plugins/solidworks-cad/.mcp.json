{
  "mcpServers": {
    "solidworks": {
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${CLAUDE_PLUGIN_ROOT}/scripts/start-mcp.ps1"
      ],
      "cwd": "${CLAUDE_PLUGIN_ROOT}",
      "env": {
        "DSH_SOLIDWORKS_STATE_ROOT": "${CLAUDE_PLUGIN_DATA}/state",
        "DSH_SOLIDWORKS_BACKUP_ROOT": "${CLAUDE_PLUGIN_DATA}/backups"
      },
      "startup_timeout_sec": 300,
      "tool_timeout_sec": 300
    }
  }
}

